# ==============================================================================
# Backend Environment Variables Template
# ==============================================================================
# In Development: Values default to localhost / local database.
# In Production (Render): Configure these in Render Dashboard > Environment.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string in production)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/event_seat_booking?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/event_seat_booking

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Frontend Client URL for CORS (In production, set to your Vercel URL without trailing slash)
# Multiple origins can be comma-separated: https://your-app.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Seat Hold Expiration Configuration (in seconds)
HOLD_DURATION_SECONDS=120

# Email SMTP Configuration (Gmail SMTP)
# For production Gmail: Generate an App Password in Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=anuragcharan975@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
SMTP_SECURE=false
EMAIL_FROM="Event Seat Booking" <no-reply@eventseatbooking.com>

# Password OTP Configuration
OTP_EXPIRES_MINUTES=5
