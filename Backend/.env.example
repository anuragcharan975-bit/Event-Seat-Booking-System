# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Multi-document transactions require a replica set.
# For local MongoDB standalone converted to replica set: mongodb://127.0.0.1:27017/event_seat_booking?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/event_seat_booking

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_event_seat_booking_system_2026_xyz
JWT_EXPIRES_IN=24h

# Frontend Client URL for CORS
FRONTEND_URL=http://localhost:5173

# Seat Hold Expiration Configuration (in seconds)
HOLD_DURATION_SECONDS=120
