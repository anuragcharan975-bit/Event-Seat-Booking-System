# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/event_seat_booking

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_event_seat_booking_system_2026_xyz
JWT_EXPIRES_IN=24h

# Frontend Client URL for CORS
FRONTEND_URL=http://localhost:5173

# Seat Hold Expiration Configuration (in seconds)
HOLD_DURATION_SECONDS=120

# Email SMTP Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
SMTP_SECURE=false
EMAIL_FROM="Event Seat Booking" <no-reply@eventseatbooking.com>

# Password OTP Configuration
OTP_EXPIRES_MINUTES=5
